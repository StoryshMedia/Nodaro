<article class="smug-simple-text {% if additionalClasses is defined %}{{ additionalClasses }}{% endif %}">
    {% if headline.value is not empty %}
        <h2 class="{{ headline.classes }}" {% if isBackendView(_context) %} {{ adminConfig(_context, 'headline', id) }} {% endif %}>
            {{ headline.value }}
        </h2>
    {% endif %}
    {% if caption.classes is not empty or isBackendView() is same as true %}
        <div class="{{ caption.classes }}" {% if isBackendView(_context) %} {{ adminConfig(_context, 'caption', id) }} {% endif %}>
            {{ caption.value | raw }}
        </div>
    {% endif %}
</article>