<div class="{% if additionalClasses is defined %}{{ additionalClasses }}{% endif %} w-full h-full">
    {% if image.value is defined and image.value is not empty %}
        {% set imageValue = getImage(image.value, true) %}
        <img
            {% if isBackendView(_context) %} {{ adminConfig(_context, 'image', id) }} {% endif %}
            class="max-w-full max-h-full mx-auto {{ image.classes }}"
            src="{{ imageValue.src }}"
            alt="{{ imageValue.file }}" />
    {% else %}
        <img
            {% if isBackendView(_context) %} {{ adminConfig(_context, 'image', id) }} {% endif %}
            src="{{ getFallbackImage() }}"
            class="max-w-full max-h-full mx-auto" />
    {% endif %}
</div>