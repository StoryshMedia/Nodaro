<head>
    {% block headerTopScripts %}
        {% for script in scripts.headerTop %}
            {{ include('@SmugFrontend/frontend/index/script/script.html.twig', script) }}
        {% endfor %}
    {% endblock %}

    {#import the different meta tags#}
    {% block meta_tags %}
        {{ include('@SmugFrontend/frontend/index/head/meta.html.twig') }}
    {% endblock %}
    {% block schema_tags %}
        {{ include('@SmugFrontend/frontend/index/head/schema.html.twig') }}
    {% endblock %}

    {% block seo %}
        {% if seo.domain.title is defined %}
            <title itemprop="name">
                {{ seo.domain.title }} {% if seo.seoTitle is defined and seo.seoTitle is not empty %} | {{seo.seoTitle}} {% endif %}
            </title>
        {% else %}
            <title itemprop="name">
                Nodaro {% if seo.seoTitle is defined and seo.seoTitle is not empty %} | {{seo.seoTitle}} {% endif %}
            </title>
        {% endif %}
    {% endblock %}

    {% block favIcon %}
        <!-- `sizes="any"` is to fix Chrome bug -->
        <link rel="icon" href="/favicons/site/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicons/site/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/favicons/site/apple-touch-icon.png" />
        <link rel="manifest" href="/favicons/site/manifest.webmanifest" />
        <meta name="msapplication-TileColor" content="#ffffff">
        <meta name="msapplication-TileImage" content="/site/icons/ms-icon-144x144.png">
        <meta name="theme-color" content="#ffffff">
    {% endblock %}
    
    {% block styles %}
        {{ encore_entry_link_tags('smug-frontendbundle-frontend') }}
        {% for style in styles %}
            {{ encore_entry_link_tags(style) }}
        {% endfor %}
    {% endblock %}

    {% block headerBottomScripts %}
        {% for script in scripts.headerBottom %}
            {{ include('@SmugFrontend/frontend/index/script/script.html.twig', script) }}
        {% endfor %}
    {% endblock %}
</head>