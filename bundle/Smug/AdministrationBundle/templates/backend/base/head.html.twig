<head>
    <title itemprop="name">
        Admin
    </title>

    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" />

    {% block favIcon %}
        <!-- `sizes="any"` is to fix Chrome bug -->
        <link rel="icon" href="/favicons/administration/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicons/administration/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/favicons/administration/apple-touch-icon.png" />
        <link rel="manifest" href="/favicons/administration/manifest.webmanifest" />
    {% endblock %}

    {% block styles %}
        {{ encore_entry_link_tags('smug-administrationbundle-colorpicker') }}
        {{ encore_entry_link_tags('smug-administrationbundle-datatable') }}
        {{ encore_entry_link_tags('smug-administrationbundle-fileUploadPreview') }}
        {{ encore_entry_link_tags('smug-administrationbundle-dragndrop') }}
        {{ encore_entry_link_tags('smug-administrationbundle-formElements') }}
        {{ encore_entry_link_tags('smug-administrationbundle-animate') }}
        {{ encore_entry_link_tags('smug-administrationbundle-quillEditor') }}
        {{ encore_entry_link_tags('smug-administrationbundle-fullcalendar') }}
        {{ encore_entry_link_tags('smug-administrationbundle-swiper') }}
        {{ encore_entry_link_tags('smug-administrationbundle-sweetalert') }}
        {{ encore_entry_link_tags('smug-administrationbundle-tippy') }}
        {{ encore_entry_link_tags('smug-administrationbundle-rangeSlider') }}
        {{ encore_entry_link_tags('smug-administrationbundle-markdownOutput') }}
        {{ encore_entry_link_tags('smug-administrationbundle-contentEditor') }}
        {{ encore_entry_link_tags('smug-administrationbundle-select2') }}
        {{ encore_entry_link_tags('smug-administrationbundle-wizard') }}
        {{ encore_entry_link_tags('smug-administrationbundle-lightbox') }}
        {{ encore_entry_link_tags('smug-administrationbundle-scrumboard') }}
        {{ encore_entry_link_tags('smug-administrationbundle-app') }}
        {{ encore_entry_link_tags('smug-administrationbundle-administration') }}
    {% endblock %}
</head>

